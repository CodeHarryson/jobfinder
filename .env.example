# Existing persistence and protected automation routes
DATABASE_URL=
CRON_SECRET=

# Provisioned by the Inngest Vercel integration
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Google Cloud OAuth web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback

# Restricts this personal instance to one Google account.
GMAIL_ALLOWED_EMAIL=

# A long random secret used to encrypt OAuth tokens and sign OAuth state.
# Generate one with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=
